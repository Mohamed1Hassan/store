# ── Backend / Database ─────────────────────────────
# انسخ هذا الملف إلى .env.local واملأ القيم الحقيقية (لا يُرفع .env* إلى git)
# بدون DATABASE_URL يعمل الموقع تلقائياً بمخزن JSON محلي (.data/) — ممتاز للتطوير فقط.
# في الإنتاج (Vercel) يجب ضبط DATABASE_URL وإلا ستُفقد الطلبات عند إعادة تشغيل الدالة.

# قاعدة بيانات Postgres السحابية (Neon/Supabase)
# Neon مثال: postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
# Supabase مثال: postgresql://postgres.xxx:pass@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://user:password@host:5432/3ezat?sslmode=require"

# بعد ضبط DATABASE_URL نفّذ مرة واحدة:
#   npm run db:generate   (توليد Prisma Client)
#   npm run db:push       (إنشاء الجداول: Product / Lead / Appointment / EventLog)
#   npm run db:seed       (ترحيل كتالوج src/data/products.ts إلى الجدول)


# حماية لوحة الإدارة (المرحلة B2)
# انسخ إلى .env.local واملأ القيم — لا تُرفع الأسرار إلى git أبداً
# ADMIN_EMAIL="owner@sultan.store"
# ADMIN_PASSWORD="كلمة-مرور-قوية-8-أحرف-على-الأقل"
# ADMIN_SESSION_SECRET="قيمة-عشوائية-طويلة-16-حرف-على-الأقل"
# NEXTAUTH_SECRET="بديل-مقبول-لسر-الجلسة"

# إشعارات صاحب المتجر (المرحلة B2) — كلها اختيارية، وتعمل كسلسلة بدائل
# OWNER_EMAIL="owner@sultan.store"
# RESEND_API_KEY="re_..."
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# OWNER_WHATSAPP_NUMBER="201055280865"
# نسخة Google Sheets الاحتياطية (اختياري)
# GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/.../exec"

# منع السبام (المرحلة B1.3 — اختياري، يوجد بديل in-memory يعمل تلقائياً)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# رفع صور لوحة الإدارة (اختياري)
# بدونها تُحفظ الصور محلياً في public/uploads (تعمل في التطبيقات ذاتية الاستضافة فقط،
# أما على Vercel فالملفات مؤقتة فيُفضّل ضبط Cloudinary).
# لتفعيل الرفع السحابي: أنشئ Upload Preset غير موقّع في Cloudinary Dashboard
# (Settings → Upload → Upload presets → Add → Signing mode: Unsigned) ثم ضبط:
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="aogjvfdt"
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="اسم-الـ-preset"
