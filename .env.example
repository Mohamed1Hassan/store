# ── Backend / Database ─────────────────────────────
# انسخ هذا الملف إلى .env.local واملأ القيم الحقيقية (لا يُرفع .env* إلى git)
# مرحلة B1 تعمل بدون DB خارجية (مخزن ملفات محلي .data/leads.json)
# عند توفر Neon/Supabase املأ DATABASE_URL وسنفعّل Prisma بدون تغيير الـ API

# قاعدة بيانات Postgres السحابية (Neon/Supabase) — للمرحلة B1.2
DATABASE_URL="postgresql://user:password@host:5432/3ezat?sslmode=require"

# حماية لوحة الإدارة (المرحلة B2)
# انسخ إلى .env.local واملأ القيم — لا تُرفع الأسرار إلى git أبداً
# ADMIN_EMAIL="owner@sultan.store"
# ADMIN_PASSWORD="كلمة-مرور-قوية-8-أحرف-على-الأقل"
# ADMIN_SESSION_SECRET="قيمة-عشوائية-طويلة-16-حرف-على-الأقل"
# NEXTAUTH_SECRET="بديل-مقبول-لسر-الجلسة"

# إشعارات صاحب المتجر (المرحلة B2) — كلها اختيارية، وتعمل كسلسلة بدائل
# OWNER_EMAIL="owner@sultan.store"
# RESEND_API_KEY="re_..."
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# OWNER_WHATSAPP_NUMBER="201055280865"
# نسخة Google Sheets الاحتياطية (اختياري)
# GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/.../exec"

# منع السبام (المرحلة B1.3 — اختياري، يوجد بديل in-memory يعمل تلقائياً)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
